# TMDB_API_KEY: Private API key for The Movie Database (TMDB) API v3.
# Used on the server-side to automatically fetch trending, popular, top rated movies and TV shows.
TMDB_API_KEY=""

# WATCHMODE_API_KEY: Private API key for the official Watchmode API.
# Used on the server-side to search movies/TV shows, fetch metadata, and find where to watch.
WATCHMODE_API_KEY="YOUR_PRIVATE_WATCHMODE_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Authentication & Production Secrets
JWT_SECRET=""
ADMIN_INITIAL_PASSWORD=""

# External Agasobanuye Source Provider (Requires official API key & endpoint from source owner)
AGASOBANUYE_SOURCE_API_KEY=""
AGASOBANUYE_SOURCE_API_URL=""

# RapidAPI Free Live Football Data API
RAPIDAPI_FOOTBALL_KEY=""
RAPIDAPI_FOOTBALL_HOST="free-api-live-football-data.p.rapidapi.com"
